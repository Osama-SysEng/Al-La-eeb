# Al-La'eeb (اللعيب) - Environment Configuration Example
# Copy to .env and fill in real values: cp .env.example .env

# ---- Security / JWT ----
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=allaeeb-auth
JWT_AUDIENCE=allaeeb-api

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=allaeeb
POSTGRES_USER=allaeeb
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://allaeeb:change-me@postgres:5432/allaeeb

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me
REDIS_SSL=false
REDIS_URL=redis://redis:6379/0

# ---- Vector DB (Qdrant) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=player_embeddings
QDRANT_API_KEY=

# ---- Object storage (S3/MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=allaeeb-videos
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# ---- AI/ML ----
MEDIAPIPE_MODEL_PATH=/models/pose_landmarker.task
FACE_RECOGNITION_MODEL=buffalo_l
NLP_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Streaming ----
RTMP_INGEST_URL=rtmp://localhost:1935/live

# ---- App ----
APP_NAME=Al-La'eeb
ENVIRONMENT=production
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
