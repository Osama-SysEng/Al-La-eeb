FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 wget && rm -rf /var/lib/apt/lists/*
COPY backend/shared /app/shared
COPY backend/services/auth-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/services/auth-service/app ./app
ENV PYTHONPATH=/app
ENV PORT=8001
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "4"]
